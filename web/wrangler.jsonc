// Cloudflare Workers host for NoPM (ADR 0021). LIVE since 2026-11-07: this Worker serves
// https://stillnotbald.com through the route below.
// Secrets are NOT here: set them with `wrangler secret put` / `wrangler secret bulk`
// (docs/ops/CLOUDFLARE_WORKERS.md). NEXT_PUBLIC_BUILD_SHA is not here either: build with it
// set and deploy with `--var NEXT_PUBLIC_BUILD_SHA:<sha>` so /api/health reports the commit.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nopm-web",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],

  // Run near Supabase (ap-southeast-1) instead of near the caller: every page does DB calls.
  "placement": { "mode": "targeted", "region": "aws:ap-southeast-1" },

  "observability": { "enabled": true },

  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },

  // Production door: a Worker route on the zone (not a custom_domain), so the apex DNS record
  // is only a placeholder. src/lib/host/cloudflare-cron.test.ts fails if the crons below drift
  // from CRON_ROUTES.
  // FORKERS: change or remove `routes` before you deploy. This is the maintainer's zone and a
  // deploy to any other account fails. Keep it at top level: an env block would rename the Worker.
  "routes": [{ "pattern": "stillnotbald.com/*", "zone_name": "stillnotbald.com" }],
  // Explicit: routes are set, so the workers.dev subdomain stays off (set true for a forker without a zone).
  "workers_dev": false,
  "triggers": { "crons": ["7 1 * * *", "37 17 * * *"] },

  // Non-secret only. Cloudflare overwrites CF-Connecting-IP at its edge, so the
  // client-IP rate limits may trust it (src/lib/api/client-ip.ts).
  "vars": {
    "NOPM_TRUST_CF_CONNECTING_IP": "1",
    "NEXT_PUBLIC_APP_URL": "https://stillnotbald.com"
  }
}
