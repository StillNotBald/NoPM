# NoPM — required environment (copy to .env.local and fill in). NEVER commit real secrets.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>   # server-only; bypasses RLS; never expose to client
SUPABASE_DB_PASSWORD=<db-password>                       # for migrations / supabase CLI
DB_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres  # for `npm run migrate` + ops scripts

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NOPM_TOKEN_PREFIX=npm_                                   # prefix for scoped Bearer PATs (npm_...)
NOPM_ENCRYPTION_KEY=<base64-encoded-32-byte-key>          # server-only; AES-256-GCM key for BYOK assistant credentials at rest — generate with `openssl rand -base64 32`
NEXT_PUBLIC_CONTACT_URL=                                 # optional; landing page "Raise a change request" link target — defaults to the GitHub issue chooser if unset

# ── Demo login (POST /api/auth/demo-login — pre-seeded demo account) ────────
DEMO_EMAIL=<demo-account-email>                          # server-only
DEMO_PASSWORD=<demo-account-password>                    # server-only

# ── Ops scripts (seed / auth-smoke / diag — not needed to run the app) ──────
ADMIN_EMAIL=<admin-account-email>                        # auth-smoke.mjs mints a session for this user
ADMIN_PASSWORD=<admin-account-password>                  # seed scripts only

# ── CLI / MCP (client-side; also settable via `nopm auth set-token`) ────────
NOPM_API_URL=http://localhost:3000                       # base URL the CLI/MCP server calls
NOPM_TOKEN=<scoped-npm_-pat>                             # mint in Settings → API Tokens

# ── Owner-funded demo assistant key (optional, server-only) ─────────────────
# Lets the live demo's BYOK assistant work without a visitor pasting their
# own key. Rate-limited server-side. Leave unset to disable the demo key.
NOPM_DEMO_LLM_PROVIDER=openai                            # "openai" | "anthropic" | "google" | "openrouter"
NOPM_DEMO_LLM_KEY=<owner-funded-llm-api-key>              # server-only; never expose to client
NOPM_DEMO_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free # example for provider=openrouter (a free-tier model id); use e.g. gpt-4o-mini for provider=openai

# ── Integrations: Lark / Feishu approvals, weekly digest, calendar feed ─────
# REQUIRED BEFORE YOU DEPLOY THIS CODE: apply database migrations 0045 to 0054
# (20261016000045_principal_four_eyes ... 20261017000054_lifecycle_guards_2) to the
# target database FIRST, in one transaction: `npm run migrate -- --atomic` (dry run
# first with `--atomic --dry-run`; see CUTOVER/07-LARK-WAVE-ROLLOUT.md). The code reads
# and writes columns, tables and triggers those migrations create (principal-aware
# four-eyes, the integration hub, calendar feeds, API-only writes, lifecycle guards,
# delivery reliability, api_tokens.kind, card integrity). Deploying the code ahead of them
# fails governed writes. Migrations are forward-only; there is no down path.
CRON_SECRET=<random-string-at-least-32-chars>            # server-only; the host scheduler sends `Authorization: Bearer <this>` to GET /api/integrations/cron (daily retries, weekly digest, pruning). On Vercel, set it in the project env and Vercel attaches it to its own cron call (web/vercel.json). Unset = the endpoint refuses every call and the digest never sends on its own. Generate with `openssl rand -base64 32`
NOPM_TRUSTED_PROXY_HOPS=                                 # SELF-HOST ONLY: how many reverse proxies (nginx, Caddy, a load balancer) you run in front of the app. Unset/0 = trust NO client address (default; the per-address caps on the Lark relay, the invite-accept limiter and failed webhook verifications are then skipped or share one bucket). 1 = a single proxy. Too high lets a caller pick its own address. Not used on Vercel (the platform supplies the address)
NOPM_RATE_CAL_PER_MIN=60                                 # optional; calendar feed (GET /api/calendar/{token}) requests per minute PER FEED before 429. Default 60
NOPM_RATE_CAL_IP_PER_MIN=120                             # optional; calendar feed requests per minute per client address before 429. Default 120
NOPM_RATE_LARK_PER_MIN=300                               # optional; authenticated Lark webhook calls (card clicks + bot DMs) per minute per connector before 429. Default 300

# ── TEST-ONLY — never set in production ─────────────────────────────────────
# Point the Lark API client at a fake Lark server on this machine so the whole
# approval-card path can run offline in tests. Must be a bare http://127.0.0.1[:port]
# or http://localhost[:port] origin; anything else makes sends fail rather than
# fall back to the real platform. When NODE_ENV=production the override is IGNORED
# unless NOPM_ALLOW_LARK_OVERRIDE=1 is ALSO set, so a production deploy that
# inherits these by accident still talks to the real Lark. Leave both unset.
# NOPM_LARK_API_BASE_OVERRIDE=http://127.0.0.1:9999
# NOPM_ALLOW_LARK_OVERRIDE=1
